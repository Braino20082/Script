-- Funktion: Alle RemoteEvents aus ReplicatedStorage sammeln
local function getAllRemoteEvents()
    local events = {}
    
    local function searchEvents(container, path)
        for _, obj in pairs(container:GetChildren()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                table.insert(events, {
                    name = obj.Name,
                    object = obj,
                    type = obj.ClassName,
                    path = path .. "." .. obj.Name
                })
            end
            
            if obj:IsA("Folder") or obj:IsA("Configuration") then
                searchEvents(obj, path .. "." .. obj.Name)
            end
        end
    end
    
    searchEvents(ReplicatedStorage, "ReplicatedStorage")
    
    return events
end

-- Funktion: Items aus dem Spiel sammeln
local function getGameItems()
    local items = {}
    
    local function searchForItems(container, path)
        for _, obj in pairs(container:GetDescendants()) do
            if obj:IsA("Tool") or obj:IsA("Model") or 
               (obj:IsA("Folder") and obj.Name:lower():find("item")) or
               (obj:IsA("Folder") and obj.Name:lower():find("weapon")) or
               obj.Name:lower():find("gun") or obj.Name:lower():find("sword") then
                table.insert(items, {
                    name = obj.Name,
                    object = obj,
                    path = path
                })
            end
        end
    end
    
    if ReplicatedStorage:FindFirstChild("Items") then
        searchForItems(ReplicatedStorage.Items, "ReplicatedStorage.Items")
    end
    
    if ReplicatedStorage:FindFirstChild("Weapons") then
        searchForItems(ReplicatedStorage.Weapons, "ReplicatedStorage.Weapons")
    end
    
    if ReplicatedStorage:FindFirstChild("Tools") then
        searchForItems(ReplicatedStorage.Tools, "ReplicatedStorage.Tools")
    end
    
    searchForItems(ReplicatedStorage, "ReplicatedStorage")
    
    if workspace:FindFirstChild("Items") then
        searchForItems(workspace.Items, "Workspace.Items")
    end
    
    local uniqueItems = {}
    local seen = {}
    for _, item in ipairs(items) do
        if not seen[item.name] then
            seen[item.name] = true
            table.insert(uniqueItems, item)
        end
    end
    
    return uniqueItems
end

-- Funktion: Content leeren
local function clearContent()
    for _, child in pairs(ScrollFrame:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then
            child:Destroy()
        end
    end
end

-- Funktion: Items geben
local function giveItem(item)
    pcall(function()
        if item.object:IsA("Tool") then
            local tool = item.object:Clone()
            tool.Parent = player.Backpack
            print("Item gegeben: " .. item.name)
        elseif item.object:IsA("Model") then
            local model = item.object:Clone()
            model.Parent = player.Backpack
            print("Item gegeben: " .. item.name)
        end
        
        if ReplicatedStorage:FindFirstChild("GiveItem") then
            ReplicatedStorage.GiveItem:FireServer(item.name)
        elseif ReplicatedStorage:FindFirstChild("ItemShop") then
            ReplicatedStorage.ItemShop:FireServer("Buy", item.name)
        end
    end)
end

-- Funktion: Event starten aus der Event-Liste
local function startSavedEvent(eventData, duration)
    pcall(function()
        if eventData.object:IsA("RemoteEvent") then
            eventData.object:FireServer(duration or 60)
            print("Event gestartet: " .. eventData.name .. " für " .. (duration or 60) .. " Sekunden")
        elseif eventData.object:IsA("RemoteFunction") then
            eventData.object:InvokeServer(duration or 60)
            print("Event gestartet: " .. eventData.name .. " für " .. (duration or 60) .. " Sekunden")
        end
    end)
end

-- Funktion: Event zur Liste hinzufügen
local function addEventToList(eventData)
    -- Prüfe ob Event bereits existiert
    for _, saved in ipairs(savedEvents) do
        if saved.name == eventData.name then
            print("Event bereits in der Liste: " .. eventData.name)
            return
        end
    end
    
    table.insert(savedEvents, eventData)
    print("Event hinzugefügt: " .. eventData.name)
    
    -- Aktualisiere die Events-Ansicht falls sie geöffnet ist
    if EventButton.BackgroundColor3 == Color3.fromRGB(50, 150, 250) then
        showSavedEvents()
    end
end

