-- Funktion: Alle RemoteEvents und BindableEvents sammeln (ERWEITERT)
local function getAllEvents()
    local events = {}
    local eventCount = 0
    
    local function searchInContainer(container, path, depth)
        if depth > 10 then return end -- Verhindere zu tiefe Rekursion
        
        for _, obj in pairs(container:GetChildren()) do
            local success = pcall(function()
                local isEvent = obj:IsA("RemoteEvent") or 
                               obj:IsA("RemoteFunction") or 
                               obj:IsA("BindableEvent") or 
                               obj:IsA("BindableFunction")
                
                if isEvent then
                    eventCount = eventCount + 1
                    table.insert(events, {
                        name = obj.Name,
                        object = obj,
                        type = obj.ClassName,
                        path = path,
                        fullPath = path .. "." .. obj.Name,
                        parent = container.Name
                    })
                end
                
                -- Durchsuche Unterordner
                if obj:IsA("Folder") or obj:IsA("Configuration") or obj:IsA("ModuleScript") then
                    searchInContainer(obj, path .. "." .. obj.Name, depth + 1)
                end
            end)
        end
    end
    
    -- Durchsuche alle wichtigen Locations
    print("🔍 Durchsuche ReplicatedStorage...")
    searchInContainer(ReplicatedStorage, "ReplicatedStorage", 0)
    
    print("🔍 Durchsuche Workspace...")
    searchInContainer(workspace, "Workspace", 0)
    
    print("🔍 Durchsuche Players.LocalPlayer...")
    if player.Character then
        searchInContainer(player.Character, "Character", 0)
    end
    searchInContainer(player, "Player", 0)
    
    -- Durchsuche auch andere Services
    local services = {
        game:GetService("ServerScriptService"),
        game:GetService("StarterPlayer"),
        game:GetService("StarterGui"),
        game:GetService("StarterPack"),
        game:GetService("Lighting")
    }
    
    for _, service in ipairs(services) do
        pcall(function()
            print("🔍 Durchsuche " .. service.Name .. "...")
            searchInContainer(service, service.Name, 0)
        end)
    end
    
    print("✅ Gefundene Events: " .. eventCount)
    
    return events
end

-- Funktion: Items sammeln
local function getGameItems()
    local items = {}
    
    local function searchForItems(container, path)
        pcall(function()
            for _, obj in pairs(container:GetDescendants()) do
                pcall(function()
                    if obj:IsA("Tool") or 
                       (obj:IsA("Model") and obj:FindFirstChildOfClass("Tool")) or
                       obj.Name:lower():find("weapon") or 
                       obj.Name:lower():find("gun") or 
                       obj.Name:lower():find("sword") or
                       obj.Name:lower():find("item") then
                        table.insert(items, {
                            name = obj.Name,
                            object = obj,
                            path = path
                        })
                    end
                end)
            end
        end)
    end
    
    searchForItems(ReplicatedStorage, "ReplicatedStorage")
    searchForItems(workspace, "Workspace")
    
    local uniqueItems = {}
    local seen = {}
    for _, item in ipairs(items) do
        if not seen[item.name] then
            seen[item.name] = true
            table.insert(uniqueItems, item)
        end
    end
    
    return uniqueItems
end

