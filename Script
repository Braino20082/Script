-- Hilfsfunktionen: scan ReplicatedStorage nach RemoteEvents (für Events2-Liste)
local function getAllRemoteEvents()
    local events = {}
    local function search(container, path)
        for _, obj in pairs(container:GetChildren()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                table.insert(events, {
                    name = obj.Name,
                    object = obj,
                    type = obj.ClassName,
                    path = path .. "." .. obj.Name
                })
            end
            if obj:IsA("Folder") or obj:IsA("Configuration") then
                search(obj, path .. "." .. obj.Name)
            end
        end
    end
    search(ReplicatedStorage, "ReplicatedStorage")
    return events
end

-- Items suchen (für Give-Tab)
local function getGameItems()
    local items = {}
    local function search(container, path)
        for _, obj in pairs(container:GetDescendants()) do
            if obj:IsA("Tool") or obj:IsA("Model") or (obj:IsA("Folder") and obj.Name:lower():find("item")) then
                table.insert(items, {name = obj.Name, object = obj, path = path})
            end
        end
    end
    if ReplicatedStorage:FindFirstChild("Items") then search(ReplicatedStorage.Items, "ReplicatedStorage.Items") end
    if ReplicatedStorage:FindFirstChild("Weapons") then search(ReplicatedStorage.Weapons, "ReplicatedStorage.Weapons") end
    if ReplicatedStorage:FindFirstChild("Tools") then search(ReplicatedStorage.Tools, "ReplicatedStorage.Tools") end
    -- fallback: durchsuchen von ReplicatedStorage
    search(ReplicatedStorage, "ReplicatedStorage")
    local unique = {}
    local seen = {}
    for _, it in ipairs(items) do
        if not seen[it.name] then
            seen[it.name] = true
            table.insert(unique, it)
        end
    end
    return unique
end

-- clear content
local function clearContent()
    for _, c in pairs(ScrollFrame:GetChildren()) do
        if c:IsA("Frame") or c:IsA("TextLabel") or c:IsA("TextButton") or c:IsA("TextBox") then
            c:Destroy()
        end
    end
end

-- startSavedEvent: sendet Startanfrage an Server (nur EventName & Dauer)
local function startSavedEvent(eventData, duration)
    if not eventData or type(eventData.name) ~= "string" then return end
    local dur = tonumber(duration) or 60
    EventStart:FireServer(eventData.name, dur)
    -- Option: lokale Bestätigung anzeigen
    print("Anfrage: Event starten ->", eventData.name, dur)
end

