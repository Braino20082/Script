local ReplicatedStorage = game:GetService("ReplicatedStorage")
local EventRemote = ReplicatedStorage:WaitForChild("StartGameEvent")

-- GUI erzeugen
local screen = Instance.new("ScreenGui")
screen.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Parent = screen
frame.Size = UDim2.new(0, 300, 0, 200)
frame.Position = UDim2.new(0.5, -150, 0.5, -100)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)

local title = Instance.new("TextLabel")
title.Parent = frame
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
title.Text = "Event Manager"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 20

local meteorButton = Instance.new("TextButton")
meteorButton.Parent = frame
meteorButton.Size = UDim2.new(0.8, 0, 0, 40)
meteorButton.Position = UDim2.new(0.1, 0, 0.4, 0)
meteorButton.Text = "Meteor Shower starten"
meteorButton.Font = Enum.Font.Gotham
meteorButton.TextSize = 16
meteorButton.BackgroundColor3 = Color3.fromRGB(60, 180, 75)
meteorButton.TextColor3 = Color3.new(1, 1, 1)

local zombieButton = meteorButton:Clone()
zombieButton.Parent = frame
zombieButton.Position = UDim2.new(0.1, 0, 0.7, 0)
zombieButton.Text = "Zombie Attack starten"

-- Button-Aktionen
meteorButton.MouseButton1Click:Connect(function()
	EventRemote:FireServer("MeteorShower")
end)

zombieButton.MouseButton1Click:Connect(function()
	EventRemote:FireServer("ZombieAttack")
end)
