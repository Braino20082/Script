-- Funktion: Event starten mit verschiedenen Methoden
local function fireEvent(eventData, ...)
    local args = {...}
    local success = false
    
    print("🔥 Versuche Event zu starten: " .. eventData.name)
    print("📊 Event Type: " .. eventData.type)
    print("📦 Parameter: " .. tostring(#args))
    
    -- Methode 1: Direktes Feuern mit allen Varianten
    local worked, errorMsg = pcall(function()
        if eventData.object:IsA("RemoteEvent") then
            -- Verschiedene Argument-Varianten ausprobieren
            eventData.object:FireServer(unpack(args))
            print("✅ RemoteEvent:FireServer() erfolgreich!")
            success = true
        elseif eventData.object:IsA("RemoteFunction") then
            local result = eventData.object:InvokeServer(unpack(args))
            print("✅ RemoteFunction:InvokeServer() erfolgreich! Result: " .. tostring(result))
            success = true
        elseif eventData.object:IsA("BindableEvent") then
            eventData.object:Fire(unpack(args))
            print("✅ BindableEvent:Fire() erfolgreich!")
            success = true
        elseif eventData.object:IsA("BindableFunction") then
            local result = eventData.object:Invoke(unpack(args))
            print("✅ BindableFunction:Invoke() erfolgreich! Result: " .. tostring(result))
            success = true
        end
    end)
    
    if not worked then
        print("❌ Fehler beim Event-Start: " .. tostring(errorMsg))
    end
    
    -- Methode 2: Alternative Aufrufe ohne Parameter
    if not success and #args > 0 then
        print("🔄 Versuche ohne Parameter...")
        pcall(function()
            if eventData.object:IsA("RemoteEvent") then
                eventData.object:FireServer()
                print("✅ Event ohne Parameter gestartet!")
                success = true
            elseif eventData.object:IsA("RemoteFunction") then
                eventData.object:InvokeServer()
                print("✅ Event ohne Parameter gestartet!")
                success = true
            end
        end)
    end
    
    -- Methode 3: Versuche häufige Event-Namen-Pattern
    if not success then
        print("🔄 Versuche alternative Methoden...")
        
        -- Suche nach Start-Events
        local possibleStarters = {
            "StartEvent",
            "ActivateEvent", 
            "TriggerEvent",
            "FireEvent",
            "RunEvent"
        }
        
        for _, starterName in ipairs(possibleStarters) do
            local starter = ReplicatedStorage:FindFirstChild(starterName, true)
            if starter and (starter:IsA("RemoteEvent") or starter:IsA("RemoteFunction")) then
                pcall(function()
                    if starter:IsA("RemoteEvent") then
                        starter:FireServer(eventData.name, unpack(args))
                        print("✅ Event über " .. starterName .. " gestartet!")
                        success = true
                    else
                        starter:InvokeServer(eventData.name, unpack(args))
                        print("✅ Event über " .. starterName .. " gestartet!")
                        success = true
                    end
                end)
                if success then break end
            end
        end
    end
    
    -- Methode 4: Versuche mit Event-Namen als String
    if not success then
        pcall(function()
            if eventData.object:IsA("RemoteEvent") then
                eventData.object:FireServer(eventData.name, unpack(args))
                print("✅ Event mit Namen als Parameter gestartet!")
                success = true
            elseif eventData.object:IsA("RemoteFunction") then
                eventData.object:InvokeServer(eventData.name, unpack(args))
                print("✅ Event mit Namen als Parameter gestartet!")
                success = true
            end
        end)
    end
    
    if success then
        print("✅✅✅ EVENT ERFOLGREICH GESTARTET: " .. eventData.name .. " ✅✅✅")
    else
        print("⚠️ Konnte Event nicht starten. Event existiert aber im Spiel.")
    end
    
    return success
end

-- Funktion: Event zur Liste hinzufügen
local function addEventToList(eventData)
    for _, saved in ipairs(savedEvents) do
        if saved.fullPath == eventData.fullPath then
            print("⚠️ Event bereits in der Liste: " .. eventData.name)
            return false
        end
    end
    
    table.insert(savedEvents, eventData)
    print("✅ Event hinzugefügt: " .. eventData.name)
    return true
end

-- Funktion: Items geben
local function giveItem(item)
    pcall(function()
        if item.object:IsA("Tool") then
            local tool = item.object:Clone()
            tool.Parent = player.Backpack
            print("✅ Item gegeben: " .. item.name)
        elseif item.object:IsA("Model") then
            local model = item.object:Clone()
            model.Parent = player.Backpack
            print("✅ Item gegeben: " .. item.name)
        end
    end)
end

