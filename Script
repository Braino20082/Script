-- Funktion: Items aus dem Spiel sammeln
local function getGameItems()
    local items = {}
    
    -- Suche in ReplicatedStorage
    local function searchForItems(container, path)
        for _, obj in pairs(container:GetDescendants()) do
            if obj:IsA("Tool") or obj:IsA("Model") or 
               (obj:IsA("Folder") and obj.Name:lower():find("item")) or
               (obj:IsA("Folder") and obj.Name:lower():find("weapon")) or
               obj.Name:lower():find("gun") or obj.Name:lower():find("sword") then
                table.insert(items, {
                    name = obj.Name,
                    object = obj,
                    path = path
                })
            end
        end
    end
    
    -- Suche in verschiedenen Locations
    if ReplicatedStorage:FindFirstChild("Items") then
        searchForItems(ReplicatedStorage.Items, "ReplicatedStorage.Items")
    end
    
    if ReplicatedStorage:FindFirstChild("Weapons") then
        searchForItems(ReplicatedStorage.Weapons, "ReplicatedStorage.Weapons")
    end
    
    if ReplicatedStorage:FindFirstChild("Tools") then
        searchForItems(ReplicatedStorage.Tools, "ReplicatedStorage.Tools")
    end
    
    -- Durchsuche komplettes ReplicatedStorage
    searchForItems(ReplicatedStorage, "ReplicatedStorage")
    
    -- Suche auch im Workspace
    if workspace:FindFirstChild("Items") then
        searchForItems(workspace.Items, "Workspace.Items")
    end
    
    -- Entferne Duplikate
    local uniqueItems = {}
    local seen = {}
    for _, item in ipairs(items) do
        if not seen[item.name] then
            seen[item.name] = true
            table.insert(uniqueItems, item)
        end
    end
    
    return uniqueItems
end

-- Funktion: Events aus dem Spiel sammeln
local function getGameEvents()
    local events = {}
    
    -- Suche nach Event-RemoteEvents und RemoteFunctions
    local function searchForEvents(container)
        for _, obj in pairs(container:GetDescendants()) do
            if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                if obj.Name:lower():find("event") or 
                   obj.Name:lower():find("start") or
                   obj.Name:lower():find("activate") then
                    table.insert(events, {
                        name = obj.Name,
                        object = obj,
                        type = obj.ClassName
                    })
                end
            end
        end
    end
    
    searchForEvents(ReplicatedStorage)
    
    -- Suche auch nach Event-Folders
    if ReplicatedStorage:FindFirstChild("Events") then
        for _, event in pairs(ReplicatedStorage.Events:GetChildren()) do
            table.insert(events, {
                name = event.Name,
                object = event,
                type = "Folder"
            })
        end
    end
    
    return events
end

-- Funktion: Content leeren
local function clearContent()
    for _, child in pairs(ScrollFrame:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then
            child:Destroy()
        end
    end
end

-- Funktion: Items geben
local function giveItem(item)
    pcall(function()
        if item.object:IsA("Tool") then
            local tool = item.object:Clone()
            tool.Parent = player.Backpack
            print("Item gegeben: " .. item.name)
        elseif item.object:IsA("Model") then
            local model = item.object:Clone()
            model.Parent = player.Backpack
            print("Item gegeben: " .. item.name)
        end
        
        -- Versuche auch über RemoteEvent zu geben
        if ReplicatedStorage:FindFirstChild("GiveItem") then
            ReplicatedStorage.GiveItem:FireServer(item.name)
        elseif ReplicatedStorage:FindFirstChild("ItemShop") then
            ReplicatedStorage.ItemShop:FireServer("Buy", item.name)
        end
    end)
end

-- Funktion: Event starten
local function startEvent(event, duration)
    pcall(function()
        if event.object:IsA("RemoteEvent") then
            event.object:FireServer(duration or 60)
            print("Event gestartet: " .. event.name .. " für " .. (duration or 60) .. " Sekunden")
        elseif event.object:IsA("RemoteFunction") then
            event.object:InvokeServer(duration or 60)
            print("Event gestartet: " .. event.name .. " für " .. (duration or 60) .. " Sekunden")
        end
        
        -- Alternative Event-Start Methoden
        if ReplicatedStorage:FindFirstChild("StartEvent") then
            ReplicatedStorage.StartEvent:FireServer(event.name, duration or 60)
        end
    end)
end

