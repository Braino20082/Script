                    AddButton.Text = "✅ Hinzugefügt"
                end
            end)
        end
        
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, #filtered * 75 + 10)
    end
    
    filterAndDisplay("")
    
    SearchBox.Changed:Connect(function(property)
        if property == "Text" then
            filterAndDisplay(SearchBox.Text)
        end
    end)
end

-- Items Anzeige
local function showItems()
    clearContent()
    local gameItems = getGameItems()
    CountLabel.Text = "Items: " .. #gameItems
    
    if #gameItems == 0 then
        local NoItemsLabel = Instance.new("TextLabel")
        NoItemsLabel.Parent = ScrollFrame
        NoItemsLabel.BackgroundTransparency = 1
        NoItemsLabel.Position = UDim2.new(0, 10, 0, 10)
        NoItemsLabel.Size = UDim2.new(1, -20, 0, 30)
        NoItemsLabel.Font = Enum.Font.Gotham
        NoItemsLabel.Text = "Keine Items gefunden"
        NoItemsLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        NoItemsLabel.TextSize = 14
        return
    end
    
    local columns = 3
    local itemWidth = 175
    local itemHeight = 80
    local spacing = 10
    
    for i, item in ipairs(gameItems) do
        local row = math.floor((i-1) / columns)
        local col = (i-1) % columns
        
        local ItemFrame = Instance.new("Frame")
        ItemFrame.Parent = ScrollFrame
        ItemFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        ItemFrame.Position = UDim2.new(0, col * (itemWidth + spacing) + 5, 0, row * (itemHeight + spacing) + 5)
        ItemFrame.Size = UDim2.new(0, itemWidth, 0, itemHeight)
        
        local ItemCorner = Instance.new("UICorner")
        ItemCorner.CornerRadius = UDim.new(0, 8)
        ItemCorner.Parent = ItemFrame
        
        local ItemName = Instance.new("TextLabel")
        ItemName.Parent = ItemFrame
        ItemName.BackgroundTransparency = 1
        ItemName.Position = UDim2.new(0, 5, 0, 5)
        ItemName.Size = UDim2.new(1, -10, 0, 40)
        ItemName.Font = Enum.Font.GothamBold
        ItemName.Text = item.name
        ItemName.TextColor3 = Color3.fromRGB(255, 255, 255)
        ItemName.TextSize = 12
        ItemName.TextWrapped = true
        
        local GiveItemButton = Instance.new("TextButton")
        GiveItemButton.Parent = ItemFrame
        GiveItemButton.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
        GiveItemButton.Position = UDim2.new(0, 10, 1, -35)
        GiveItemButton.Size = UDim2.new(1, -20, 0, 30)
        GiveItemButton.Font = Enum.Font.GothamBold
        GiveItemButton.Text = "✅ Geben"
        GiveItemButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        GiveItemButton.TextSize = 12
        
        local GiveCorner = Instance.new("UICorner")
        GiveCorner.CornerRadius = UDim.new(0, 5)
        GiveCorner.Parent = GiveItemButton
        
        GiveItemButton.MouseButton1Click:Connect(function()
            giveItem(item)
        end)
    end
    
    local rows = math.ceil(#gameItems / columns)
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, rows * (itemHeight + spacing) + 10)
end

