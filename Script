-- Funktion zum Leeren des Content
local function clearContent()
    for _, child in pairs(ScrollFrame:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then
            child:Destroy()
        end
    end
end

-- Event Anzeige
local function showEvents()
    clearContent()
    
    for i, event in ipairs(events) do
        local EventFrame = Instance.new("Frame")
        EventFrame.Parent = ScrollFrame
        EventFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        EventFrame.Position = UDim2.new(0, 10, 0, (i-1) * 120 + 10)
        EventFrame.Size = UDim2.new(1, -20, 0, 110)
        
        local EventFrameCorner = Instance.new("UICorner")
        EventFrameCorner.CornerRadius = UDim.new(0, 8)
        EventFrameCorner.Parent = EventFrame
        
        local EventName = Instance.new("TextLabel")
        EventName.Parent = EventFrame
        EventName.BackgroundTransparency = 1
        EventName.Position = UDim2.new(0, 10, 0, 5)
        EventName.Size = UDim2.new(1, -20, 0, 25)
        EventName.Font = Enum.Font.GothamBold
        EventName.Text = event.name
        EventName.TextColor3 = Color3.fromRGB(255, 255, 255)
        EventName.TextSize = 16
        EventName.TextXAlignment = Enum.TextXAlignment.Left
        
        local EventDesc = Instance.new("TextLabel")
        EventDesc.Parent = EventFrame
        EventDesc.BackgroundTransparency = 1
        EventDesc.Position = UDim2.new(0, 10, 0, 30)
        EventDesc.Size = UDim2.new(1, -20, 0, 20)
        EventDesc.Font = Enum.Font.Gotham
        EventDesc.Text = event.description
        EventDesc.TextColor3 = Color3.fromRGB(200, 200, 200)
        EventDesc.TextSize = 12
        EventDesc.TextXAlignment = Enum.TextXAlignment.Left
        
        local DurationInput = Instance.new("TextBox")
        DurationInput.Parent = EventFrame
        DurationInput.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
        DurationInput.Position = UDim2.new(0, 10, 0, 55)
        DurationInput.Size = UDim2.new(0, 150, 0, 30)
        DurationInput.Font = Enum.Font.Gotham
        DurationInput.PlaceholderText = "Dauer (Minuten)"
        DurationInput.Text = ""
        DurationInput.TextColor3 = Color3.fromRGB(255, 255, 255)
        DurationInput.TextSize = 14
        
        local DurationCorner = Instance.new("UICorner")
        DurationCorner.CornerRadius = UDim.new(0, 5)
        DurationCorner.Parent = DurationInput
        
        local StartButton = Instance.new("TextButton")
        StartButton.Parent = EventFrame
        StartButton.BackgroundColor3 = Color3.fromRGB(50, 200, 100)
        StartButton.Position = UDim2.new(0, 170, 0, 55)
        StartButton.Size = UDim2.new(0, 100, 0, 30)
        StartButton.Font = Enum.Font.GothamBold
        StartButton.Text = "Starten"
        StartButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        StartButton.TextSize = 14
        
        local StartCorner = Instance.new("UICorner")
        StartCorner.CornerRadius = UDim.new(0, 5)
        StartCorner.Parent = StartButton
        
        StartButton.MouseButton1Click:Connect(function()
            local duration = DurationInput.Text
            print("Event gestartet: " .. event.name .. " für " .. duration .. " Minuten")
            -- Hier kannst du deinen Event-Start Code einfügen
        end)
    end
    
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, #events * 120 + 20)
end

-- Give Items Anzeige
local function showItems()
    clearContent()
    
    local columns = 3
    local itemWidth = 140
    local itemHeight = 50
    local spacing = 10
    
    for i, item in ipairs(items) do
        local row = math.floor((i-1) / columns)
        local col = (i-1) % columns
        
        local ItemButton = Instance.new("TextButton")
        ItemButton.Parent = ScrollFrame
        ItemButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        ItemButton.Position = UDim2.new(0, col * (itemWidth + spacing) + 10, 0, row * (itemHeight + spacing) + 10)
        ItemButton.Size = UDim2.new(0, itemWidth, 0, itemHeight)
        ItemButton.Font = Enum.Font.Gotham
        ItemButton.Text = item
        ItemButton.TextColor3 = Color3.fromRGB(255, 255, 255)
        ItemButton.TextSize = 14
        
        local ItemCorner = Instance.new("UICorner")
        ItemCorner.CornerRadius = UDim.new(0, 8)
        ItemCorner.Parent = ItemButton
        
        ItemButton.MouseButton1Click:Connect(function()
            print("Item gegeben: " .. item)
            -- Hier kannst du deinen Give-Item Code einfügen
        end)
    end
    
    local rows = math.ceil(#items / columns)
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, rows * (itemHeight + spacing) + 20)
end

-- Button Events
